@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix ns: <http://abandoned.cars.com/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix parea: <http://parliament.uk/ontologies/geographic-area/> .

ns: a owl:Ontology ;
    dc:creator "Alejandro Ortega Hernandez",
        "Alejandro San Juan Sanchez",
        "Cesar Ruiz Deiros",
        "Luis Alonso Reillo",
        "Marc Ramirez Sebastia" ;
    owl:versionInfo "0.0.1" ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

ns:hasAmount a owl:DatatypeProperty ;
    rdfs:label "has amount" ;
    rdfs:domain ns:Data ;
    rdfs:range xsd:integer .

ns:hasDistrict a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "has district" ;
    rdfs:domain ns:Data ;
    rdfs:range ns:District,
        xsd:District .

ns:hasONSCode a owl:DatatypeProperty ;
    rdfs:label "has o n s code" ;
    rdfs:domain ns:District ;
    rdfs:range xsd:string .

ns:hasYear a owl:DatatypeProperty ;
    rdfs:label "has year" ;
    rdfs:domain ns:Data ;
    rdfs:range xsd:integer .

parea:partlyContainedBy a owl:ObjectProperty ;
    rdfs:label "partly contained by" ;
    rdfs:domain ns:District ;
    rdfs:range parea:GeographicArea ;
    rdfs:comment "Relates a geographic area to a geographic area it is partly contained by, according to UK government ontology." .


dc:creator a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

ns:Data a owl:Class ;
    rdfs:label "Data" .

ns:District a owl:Class ;
    rdfs:label "District" .
    rdfs:subClassOf parea:GeographicArea .

parea:EnglishRegion rdf:type owl:Class ;
    rdfs:subClassOf parea:GeographicArea ;
    rdfs:label "English region"@en ;
    rdfs:comment "A statistical region in England, formerly known as a government office region, being an International Territorial Level (ITL) 1 unit, formerly known as a NUTS 1 unit."@en ;
    rdfs:isDefinedBy <http://parliament.uk/ontologies/geographic-area/> .
